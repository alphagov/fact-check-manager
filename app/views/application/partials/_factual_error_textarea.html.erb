<%= render "govuk_publishing_components/components/character_count", {
      textarea: {
        label: {
              text: t("fact_check_response.factual_errors"),
              heading_size: "m",
            },
            name: "fact_check_response[body]",
            hint: sanitize(t("fact_check_response.factual_errors_hint")),
            value: @form_data&.dig(:body),
            error: @errors[:body].presence,
            error_message: (@errors[:body].presence&.first),
            rows: 18,
          },
      id: "fact_check_details",
      threshold: 95,
      maxlength: 9000,
}
%>
