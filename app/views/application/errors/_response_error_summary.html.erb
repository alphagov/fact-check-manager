<%= render "govuk_publishing_components/components/error_summary", {
  id: "error-summary",
  title: t("fact_check_response.error_heading"),
  items: [
    {
      text: @errors[:accepted] || @errors[:body],
      href: @errors[:accepted].present? ? "#selection_radio_buttons" : "#fact_check_details",
      data_attributes: {
        module: "ga4-auto-tracker",
        "ga4-auto": {
          event_name: "form_error",
          type: t("fact_check_response.heading"),
          text: @errors[:accepted] || @errors[:body],
          section: t("fact_check_response.heading"),
          action: "error",
        },
      },
    },
  ],
} %>
