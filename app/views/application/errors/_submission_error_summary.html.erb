<%= render "govuk_publishing_components/components/error_summary", {
  title: t("fact_check_verification.error_heading"),
  items: @errors.map do |error|
    {
      text: error,
      data_attributes: {
        module: "ga4-auto-tracker",
        "ga4-auto": {
          event_name: "form_error",
          type: t("fact_check_verification.heading"),
          text: error,
          section: t("fact_check_verification.heading"),
          action: "error",
        },
      },
    }
  end,
} %>
