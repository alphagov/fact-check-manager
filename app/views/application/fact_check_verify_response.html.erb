<% content_for :page_title, @request.source_title %>
<% content_for :title_context, @request.source_title %>
<% content_for :title, t("fact_check_verification.heading") %>
<% content_for :back_control do %>
  <%= button_tag t("fact_check_verification.back_link"),
                type: "submit",
                form: "back-form",
                class: "button-back-link",
                data: {
                  module: "ga4-link-tracker",
                  ga4_link: {
                    event_name: "form_response",
                    action: "back",
                    section: "Back",
                    type: "back",
                    url: "/requests/#{@request.source_app}/#{@request.source_id}/respond?back=true",
                  },
                }
                %>
<% end %>

<%= form_with url: respond_path(source_app: @request.source_app, source_id: @request.source_id, back: true),
              method: :post,
              id: "back-form",
              scope: :fact_check_response,
              data: {
                module: "ga4-form-tracker",
                ga4_section: "Back",
              } do |f| %>
  <%= hidden_field_tag "fact_check_response[accepted]", @form_data[:accepted] %>
  <%= hidden_field_tag "fact_check_response[body]", @form_data[:body] %>
<% end %>

<% if @errors.present? %>
  <% content_for :error_summary, render(partial: "application/errors/submission_error_summary") %>
<% end %>

<div class="govuk-grid-row">
  <div
    class="govuk-grid-column-two-thirds"
    data-module="ga4-links-setup ga4-link-tracker ga4-form-tracker"
    data-ga4-section='<%= t("fact_check_verification.heading") %>'
  >
    <%= form_with url: confirm_response_path(source_app: @request.source_app, source_id: @request.source_id),
                  method: :post,
                  scope: :fact_check_response do |f| %>
      <%= hidden_field_tag "fact_check_response[accepted]", @form_data[:accepted] %>
      <%= hidden_field_tag "fact_check_response[body]", @form_data[:body] %>
      <%= render "govuk_publishing_components/components/summary_list", {
        items: [
          {
            field: t("fact_check_verification.confirm_changes"),
            value: @form_data[:accepted] == "true" ?
              t("fact_check_response.correct") :
              t("fact_check_response.incorrect"),
          },
          (@form_data[:accepted] == "false" ? {
            field: t("fact_check_verification.factual_errors"),
            value: simple_format(@form_data[:body]),
          } : nil),
        ].compact,
        margin_bottom: 9,
      } %>

      <%= render "govuk_publishing_components/components/warning_text", {
        text: t("fact_check_verification.send_response_warning"),
      } %>

      <div class="govuk-button-group">
        <%= render "govuk_publishing_components/components/button", {
          text: t("fact_check_verification.confirm_button"),
          margin_bottom: 6,
        } %>

        <%= button_tag t("fact_check_verification.change_answers_button"),
                       type: "submit",
                       form: "back-form",
                       class: "gem-c-button govuk-button govuk-button--secondary",
                       data: {
                         module: "ga4-link-tracker",
                         ga4_link: {
                           event_name: "form_response",
                           action: "back",
                           section: "Back",
                           type: "back",
                           url: "/requests/#{@request.source_app}/#{@request.source_id}/respond?back=true",
                         },
                       }
        %>
      </div>
    <% end %>
  </div>
</div>
