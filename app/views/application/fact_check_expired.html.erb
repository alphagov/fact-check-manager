<% content_for :title_context, @request.source_title %>
<% content_for :title, t("fact_check_expired.heading") %>
<% content_for :page_title, t("fact_check_expired.heading") %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds" data-module="ga4-links-setup ga4-link-tracker">
<p class="govuk-body"> <%= t("fact_check_expired.response_too_old") %> </p>
      <p class="govuk-body"> <%= t("fact_check_expired.questions") %>
        <% if @request.zendesk_number.present? %>
          <%= link_to "Zendesk ticket",
              "https://govuk.zendesk.com/tickets/#{@request.zendesk_number}",
               class: "govuk-link--no-visited-state govuk-link" %>.
        <% else %>
          Zendesk ticket.
        <% end %>
      </p>
  </div>
</div>
